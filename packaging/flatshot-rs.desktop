[Desktop Entry]
Type=Application
Name=Flatshot RS
GenericName=Screenshot Tool
Comment=Region screenshots with a floating draw toolbar and QR code scanning
Exec=flatshot-rs --tray
Icon=flatshot-rs
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;capture;snip;qr;barcode;annotate;ocr;text;flatshot;
StartupNotify=false
StartupWMClass=flatshot-rs
Actions=Region;Monitor;Full;LastRegion;Pin;CopyText;Recent;Settings;

[Desktop Action Region]
Name=Capture Region
Exec=flatshot-rs

[Desktop Action Monitor]
Name=Capture Current Monitor
Exec=flatshot-rs --monitor

[Desktop Action Full]
Name=Capture All Screens
Exec=flatshot-rs --full

[Desktop Action LastRegion]
Name=Capture Last Region
Exec=flatshot-rs --last-region

[Desktop Action Pin]
Name=Pin Region to Screen
Exec=flatshot-rs --pin

[Desktop Action CopyText]
Name=Copy Text from Screen
Exec=flatshot-rs --ocr

[Desktop Action Recent]
Name=Recent Captures
Exec=flatshot-rs --recent

[Desktop Action Settings]
Name=Settings
Exec=flatshot-rs --settings
