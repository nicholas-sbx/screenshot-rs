[Desktop Entry]
Type=Application
Name=Flatshot
GenericName=Screenshot Tool
Comment=Region screenshots with a floating draw toolbar and QR code scanning
Exec=flatshot --tray
Icon=flatshot
Terminal=false
Categories=Graphics;Utility;
Keywords=screenshot;capture;snip;qr;barcode;annotate;
StartupNotify=false
Actions=Region;Monitor;Full;LastRegion;Pin;Settings;

[Desktop Action Region]
Name=Capture Region
Exec=flatshot

[Desktop Action Monitor]
Name=Capture Current Monitor
Exec=flatshot --monitor

[Desktop Action Full]
Name=Capture All Screens
Exec=flatshot --full

[Desktop Action LastRegion]
Name=Capture Last Region
Exec=flatshot --last-region

[Desktop Action Pin]
Name=Pin Region to Screen
Exec=flatshot --pin

[Desktop Action Settings]
Name=Settings
Exec=flatshot --settings
