[Desktop Entry]
Type=Application
Name=Flatshot RS screen capture
Comment=Lets Flatshot RS take the screen through KWin's screenshot API
Exec=/usr/bin/flatshot-rs
Icon=flatshot-rs
NoDisplay=true
Terminal=false
# KWin serves its screenshot API only to the executables named (by their
# absolute path) in a desktop file with this key: it grants it to
# /usr/bin/flatshot-rs, and nothing else.
X-KDE-DBUS-Restricted-Interfaces=org.kde.KWin.ScreenShot2
