# Maintainer: nicholas-sbx <nicholas-sbx@users.noreply.github.com>
#
# Builds Flatshot RS from a release's source. The ready-made package (and a
# pacman repository with it) comes with each GitHub release; see README.md.
# To build the code you have checked out instead: FLATSHOT_SRC=$PWD/../.. makepkg
pkgname=flatshot-rs
pkgver=1.6.1
pkgrel=1
pkgdesc="Region screenshots for Wayland and X11 (KDE first) with a floating draw toolbar and QR code scanning"
arch=('x86_64' 'aarch64')
url="https://github.com/nicholas-sbx/screenshot-rs"
license=('MIT')
depends=('glibc' 'gcc-libs' 'libxkbcommon' 'ttf-font')
makedepends=('cargo')
optdepends=(
    'wl-clipboard: keep the clipboard after a one-off capture exits'
    'xdg-utils: open captures and links'
    'spectacle: capture fallback on KDE'
    'grim: capture fallback on wlroots compositors'
    'gst-plugin-pipewire: screen recording on KDE and GNOME (with gst-plugins-good)'
    'gst-plugins-good: screen recording on KDE and GNOME (WebM, MP4 files)'
    'gst-plugins-ugly: H.264 for MP4 recordings'
    'ffmpeg: pausing a recording, GIFs, and screen recording on X11'
    'wf-recorder: screen recording on wlroots compositors'
    'xclip: on X11, keep the clipboard after a one-off capture exits'
    'tesseract-data-eng: copy text from the screen (OCR; other tesseract-data-* for more languages)'
)
options=('!lto')
if [ -z "${FLATSHOT_SRC:-}" ]; then
    source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
    sha256sums=('SKIP')
fi

_src() {
    if [ -n "${FLATSHOT_SRC:-}" ]; then
        echo "$FLATSHOT_SRC"
    else
        echo "$srcdir/screenshot-rs-$pkgver"
    fi
}

prepare() {
    cd "$(_src)"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$(_src)"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR="$srcdir/target"
    cargo build --frozen --release
}

check() {
    cd "$(_src)"
    "$srcdir/target/release/flatshot-rs" --self-test
}

package() {
    cd "$(_src)"
    install -Dm755 "$srcdir/target/release/flatshot-rs" "$pkgdir/usr/bin/flatshot-rs"
    install -Dm644 packaging/flatshot-rs.desktop "$pkgdir/usr/share/applications/flatshot-rs.desktop"
    install -Dm644 packaging/flatshot-rs-kwin.desktop "$pkgdir/usr/share/applications/flatshot-rs-kwin.desktop"
    install -Dm644 assets/flatshot-rs.notifyrc "$pkgdir/usr/share/knotifications6/flatshot-rs.notifyrc"
    install -Dm644 assets/flatshot-rs.notifyrc "$pkgdir/usr/share/knotifications5/flatshot-rs.notifyrc"
    install -Dm644 assets/flatshot-rs.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/flatshot-rs.svg"
    install -Dm644 assets/flatshot-rs.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/flatshot-rs.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
